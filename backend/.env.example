# Server Configuration
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# AI Provider Configuration
# Set LLM_PROVIDER to "gemini", "openai", or "auto" (auto detects whichever key is present)
LLM_PROVIDER=auto

# Option 1: Google Gemini API Key (recommended free tier friendly)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenAI API Key (or any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
